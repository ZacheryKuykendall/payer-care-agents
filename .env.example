# Copy to .env only if you are running against real Azure resources.
#
# None of this is needed for the demo. `make demo`, `make serve`, `make evals` and
# `make test` all run in mock mode with no credentials and no network.

# mock (default) or azure. Azure mode validates everything below and fails fast,
# naming every missing setting at once.
PAYER_AGENTS_MODE=mock

# --- Microsoft Foundry -------------------------------------------------------
# The resource endpoint from the deployment details page. The decision API lives at
# {endpoint}/providers/microsoft/v1/systemone.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com

# Deployment names, not catalog model names. The decision API's `model` field takes
# the deployment name.
FOUNDRY_DECISION_DEPLOYMENT=decision-router
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Leave unset. Entra ID via DefaultAzureCredential is the supported path; a key is
# accepted for local experiments and discouraged everywhere else. The Bicep sets
# disableLocalAuth on the Foundry account, so keys will not work against it.
# FOUNDRY_API_KEY=

# --- Azure AI Search ---------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_BENEFITS_INDEX=plan-benefits
AZURE_SEARCH_POLICY_INDEX=medical-policy
# AZURE_SEARCH_API_KEY=

# --- Tool gateway ------------------------------------------------------------
# The API Management MCP endpoint. Agents never hold a FHIR credential, so there is
# deliberately no FHIR URL here.
MCP_GATEWAY_ENDPOINT=https://your-apim.azure-api.net/mcp
# MCP_GATEWAY_SUBSCRIPTION_KEY=
MCP_AGENT_ID=member-assistant

# --- Audit -------------------------------------------------------------------
# Optional second sink. The in-memory sink is always present. In Azure the durable
# destination is Event Hubs into an immutable Log Analytics workspace, configured in
# the API Management policy rather than here.
# PAYER_AGENTS_AUDIT_LOG=./out/audit.jsonl
